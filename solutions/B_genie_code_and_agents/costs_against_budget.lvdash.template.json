{
 "datasets": [
  {
   "name": "ds_costs",
   "displayName": "Costs against budget",
   "queryLines": [
    "SELECT to_date(concat(period, '-01')) AS month, period, company_name, cost_centre_name, account_name, ",
    "       actual_gbp, budget_gbp, variance_gbp ",
    "FROM __SCHEMA__.`2_actual_vs_budget` ",
    "WHERE account_type = 'Expense' AND account_code <> '5000' "
   ]
  },
  {
   "name": "ds_top",
   "displayName": "Biggest overspends",
   "queryLines": [
    "SELECT account_name, period, round(sum(actual_gbp)) AS actual_gbp, round(sum(budget_gbp)) AS budget_gbp, ",
    "       round(sum(variance_gbp)) AS variance_gbp ",
    "FROM __SCHEMA__.`2_actual_vs_budget` ",
    "WHERE account_type = 'Expense' AND account_code <> '5000' ",
    "GROUP BY account_name, period ORDER BY variance_gbp DESC LIMIT 10 "
   ]
  }
 ],
 "pages": [
